.env
__pycache__/
*.pyc
.venv/
venv/

# local db / uploaded project docs
data/*.db
data/project_docs/
data/invoice_assets/
# A backup zip is a copy of the whole database - never commit one.
data/backups/
# Same reason, and easier to miss: tools/import_notion_studio_logs.py
# copies the database to <name>.bak before its first write, and that name
# does not match data/*.db above. It is the whole database, invoices and
# client list included.
*.bak
# Written only when VAIO_DEBUG=1, to diagnose a launch that fails silently.
vaio-launch.log

# PyInstaller build artifacts
build/
dist/
*.spec

.DS_Store
